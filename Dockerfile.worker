# ==============================================================================
# DocTune Studio — Distributed Celery ML Worker Dockerfile
# ==============================================================================
# Supports both NVIDIA CUDA GPUs (on GCP / GPU hosts) and CPU fallback mode.
# ==============================================================================
FROM python:3.11-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies for Hugging Face tokenizers, PyPDF, and healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install ML stack and worker dependencies with BuildKit pip caching
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# Copy source code and configurations
COPY pipeline/ ./pipeline/
COPY web/ ./web/
COPY config/ ./config/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY VERSION .

RUN mkdir -p /app/.scratch /root/.cache/huggingface

CMD ["celery", "-A", "web.celery_app.app", "worker", "--loglevel=INFO", "-c", "1", "-Q", "training_queue,data_prep_queue"]
