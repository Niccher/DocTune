# ==============================================================================
# DocTune Studio — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# --- Application Server & Branding ---
APP_NAME="DocTune Studio"
ENVIRONMENT=production
DEBUG=false
WEB_PORT=80
WEB_HOST=0.0.0.0
SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-prod

# --- PostgreSQL Relational Database ---
POSTGRES_DB=doctune_studio
POSTGRES_USER=doctune
POSTGRES_PASSWORD=doctune_secure_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://doctune:doctune_secure_password_2026@postgres:5432/doctune_studio
DATABASE_URL_SYNC=postgresql+psycopg2://doctune:doctune_secure_password_2026@postgres:5432/doctune_studio

# --- Redis Broker & Telemetry Pub/Sub ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO S3-Compatible Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secure_password_2026
S3_BUCKET_DOCS=doc-tune-raw-docs
S3_BUCKET_DATASETS=doc-tune-datasets
S3_BUCKET_CHECKPOINTS=doc-tune-checkpoints
S3_BUCKET_MERGED=doc-tune-merged-models
S3_REGION=us-east-1

# --- Dozzle Real-Time Container Log Monitoring ---
DOZZLE_PORT=8888

# --- Hugging Face Credentials ---
# Required for gated base models (e.g., Llama-3-8B-Instruct)
HF_TOKEN=

# --- Compute & Hardware Budget Safeguards ---
MAX_CPU_THREADS=7
MAX_RAM_GB=13
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all

# --- GCP / Cloud Production Integration (Optional) ---
# If deploying to GCP with Google Cloud Storage:
# GCS_BUCKET_NAME=my-gcp-fine-tuning-bucket
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-service-account.json
